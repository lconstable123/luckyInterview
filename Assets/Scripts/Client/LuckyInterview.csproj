<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This file is generated automatically by LuckyEngine.
    Do not edit it by hand: your changes will be overwritten the next time the
    project is opened or its scripts are rebuilt.

    To add a script, create a .cs file anywhere under the Assets folder. It is
    picked up automatically, so this file never needs to be edited or regenerated
    by hand.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Configurations>Debug;Release;Dist</Configurations>
    <AssemblyName>LuckyInterview</AssemblyName>
    <RootNamespace>LuckyInterview</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RollForward>Major</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>../Binaries</OutputPath>
    <BaseIntermediateOutputPath>../Intermediates/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!-- Every .cs file under Assets is compiled. Build output and folders ending in '~' are ignored. -->
  <ItemGroup>
    <Compile Include="../../**/*.cs"
             Exclude="../../Scripts/Binaries/**;../../Scripts/Intermediates/**;../../**/*~/**">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <!--
    Engine API assemblies. The editor passes its own install location when it
    builds, so the project always resolves against the engine that opened it.
    The path below is a fallback for builds started outside the editor.
  -->
  <PropertyGroup>
    <LuckyEngineScripts Condition="'$(LuckyEngineDir)' != ''">$(LuckyEngineDir)/Resources/Scripts</LuckyEngineScripts>
    <LuckyEngineScripts Condition="'$(LuckyEngineScripts)' == ''">C:/Users/luke/Downloads/LuckyEngine-2026.2-Preview-1-Windows-x64/LuckyEngine-2026.2-Preview-1-Windows-x64/Data/Resources/Scripts</LuckyEngineScripts>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Hazel-ScriptCore">
      <HintPath>$(LuckyEngineScripts)/Hazel-ScriptCore.dll</HintPath>
    </Reference>
    <Reference Include="Coral.Managed">
      <HintPath>$(LuckyEngineScripts)/Coral.Managed.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
